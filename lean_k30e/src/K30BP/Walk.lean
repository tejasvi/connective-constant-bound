module

public import Saw38aKP.MainB
public import K30B.Check3c

@[expose] public section

/-!
# Soundness of the packed walks (speedup study)         

* `pk c = 64 ox(c.2) + ox(c.1)`: the packed offset-31 index of a cell.
* `walkCells_tf`: the packed walk in the frame of a symmetry `g`, started at the image of a cell, produces the images
  of the cells that `back` generates (`genB`).
* `ownDec_sound`: the state's own walk validates the decode and builds its bitboard: `ownDec n T = some (Sg, bb)`
  gives `decode n T = some S` with `Sg = gridB (S.map offC)`.
-/

namespace K30BP

open Saw38aCore Saw38aK Saw38a K30B

/-! ## Bit-level facts -/

theorem bitP_eq (B p : Nat) : bitP B p = B.testBit p := by
  have h1 : Nat.shiftRight B p = B / 2 ^ p := Nat.shiftRight_eq_div_pow B p
  have h2 : Nat.land (B / 2 ^ p) 1 = B / 2 ^ p % 2 := Nat.and_one_is_mod _
  unfold bitP
  rw [h1, h2, Nat.testBit_eq_decide_div_mod_eq]
  rcases Nat.mod_two_eq_zero_or_one (B / 2 ^ p) with h | h <;> rw [h] <;> rfl

theorem shiftLeft_one (p : Nat) : Nat.shiftLeft 1 p = 2 ^ p := by
  have : Nat.shiftLeft 1 p = 1 <<< p := rfl
  rw [this, Nat.shiftLeft_eq, Nat.one_mul]

theorem testBit_shiftLeft_one (p q : Nat) : (Nat.shiftLeft 1 p).testBit q = decide (p = q) := by
  rw [shiftLeft_one, Nat.testBit_two_pow]

theorem testBit_lor_shiftLeft (B p q : Nat) : (Nat.lor B (Nat.shiftLeft 1 p)).testBit q = (B.testBit q || decide (p = q)) := by
  have h2 : Nat.lor B (2 ^ p) = B ||| 2 ^ p := rfl
  rw [shiftLeft_one, h2, Nat.testBit_or, Nat.testBit_two_pow]

/-! ## Packed cells -/

def pk (c : Saw38a.Cell) : Nat := 64 * ox c.2 + ox c.1

def Near (c : Saw38a.Cell) : Prop := -30 ≤ c.1 ∧ c.1 ≤ 30 ∧ -30 ≤ c.2 ∧ c.2 ≤ 30

theorem near_of_small {c : Saw38a.Cell} (h : small c = true) : Near c := by
  simp only [small, Bool.and_eq_true, decide_eq_true_eq] at h
  unfold Near; omega

theorem pk_mod {c : Saw38a.Cell} (h : Near c) : pk c % 64 = ox c.1 := by
  unfold Near at h; unfold pk ox; omega

theorem pk_div {c : Saw38a.Cell} (h : Near c) : pk c / 64 = ox c.2 := by
  unfold Near at h; unfold pk ox; omega

theorem land63 (p : Nat) : Nat.land p 63 = p % 64 := by
  have h : Nat.land p 63 = p &&& (2 ^ 6 - 1) := rfl
  rw [h, Nat.and_two_pow_sub_one_eq_mod]

theorem shr6 (p : Nat) : Nat.shiftRight p 6 = p / 64 := by
  have h : Nat.shiftRight p 6 = p / 2 ^ 6 := Nat.shiftRight_eq_div_pow p 6
  rw [h]; norm_num

theorem pk_inj {a b : Saw38a.Cell} (ha : Near a) (hb : Near b) (h : pk a = pk b) : a = b := by
  obtain ⟨a1, a2⟩ := a
  obtain ⟨b1, b2⟩ := b
  unfold Near at ha hb
  unfold pk ox at h
  simp only at ha hb h
  have e1 : a1 = b1 := by omega
  have e2 : a2 = b2 := by omega
  rw [e1, e2]

theorem smallP_pk {c : Saw38a.Cell} (h : Near c) : smallP (pk c) = small c := by
  unfold smallP
  rw [land63, shr6, pk_mod h, pk_div h]
  obtain ⟨a, b⟩ := c
  unfold Near at h
  simp only at h
  rw [Bool.eq_iff_iff]
  simp only [small, ox, Bool.and_eq_true, Nat.ble_eq, decide_eq_true_eq]
  omega

/-! ## Steps, turns and symmetries -/

theorem stepBackP_pk {j : Nat} (hj : j < 4) {c : Saw38a.Cell} (h : small c = true) :
    stepBackP j (pk c) = pk (c.1 - (dirI j).1, c.2 - (dirI j).2) := by
  obtain ⟨a, b⟩ := c
  simp only [small, Bool.and_eq_true, decide_eq_true_eq] at h
  unfold stepBackP pk ox
  interval_cases j <;> simp [dirI] <;> omega

theorem stepBackP_pk' {j : Nat} (hj : j < 4) {c : Saw38a.Cell} (h : Near c) (h2 : Near (c.1 - (dirI j).1, c.2 - (dirI j).2)) :
    stepBackP j (pk c) = pk (c.1 - (dirI j).1, c.2 - (dirI j).2) := by
  obtain ⟨a, b⟩ := c
  unfold Near at h h2
  simp only at h h2
  unfold stepBackP pk ox
  interval_cases j <;> simp [dirI] at h2 ⊢ <;> omega

theorem gdir_lt (g i : Nat) : gdir g i < 4 := by
  unfold gdir; cases Nat.blt g 4 <;> exact Nat.mod_lt _ (by norm_num)

theorem turn_gdir : ∀ g < 8, ∀ i < 4, ∀ t < 3, turnP (swapT (Nat.ble 4 g) t) (gdir g i) = gdir g (turnIdx t i) := by
  decide

theorem d4c_dirI : ∀ g < 8, ∀ i < 4, d4c g (dirI i) = dirI (gdir g i) := by
  decide

theorem d4c_sub (g : Nat) (a b : Saw38a.Cell) : d4c g (a.1 - b.1, a.2 - b.2) = ((d4c g a).1 - (d4c g b).1, (d4c g a).2 - (d4c g b).2) := by
  obtain ⟨a1, a2⟩ := a
  obtain ⟨b1, b2⟩ := b
  rcases g with _ | _ | _ | _ | _ | _ | _ | _ | g <;> simp [d4c] <;> ring_nf <;> simp

/-- The image of a cell under the symmetry `g` followed by the shift `t`. -/
def tf (g : Nat) (t c : Saw38a.Cell) : Saw38a.Cell := addC (d4c g c) t

theorem tf_step {g : Nat} (hg : g < 8) {j : Nat} (hj : j < 4) (t c : Saw38a.Cell) :
    tf g t (c.1 - (dirI j).1, c.2 - (dirI j).2) = ((tf g t c).1 - (dirI (gdir g j)).1, (tf g t c).2 - (dirI (gdir g j)).2) := by
  unfold tf addC
  rw [d4c_sub, d4c_dirI g hg j hj]
  refine Prod.ext ?_ ?_ <;> simp only <;> ring

/-! ## The cells generated by `back` -/

def genB : Saw38a.Cell → Saw38a.Cell → List Nat → List Saw38a.Cell
  | _, _, [] => []
  | d, c, t :: ts =>
    let d' := turnBack t d
    let c' : Saw38a.Cell := (c.1 - d'.1, c.2 - d'.2)
    c' :: genB d' c' ts

theorem back_eq (ts : List Nat) : ∀ (d c : Saw38a.Cell) (acc : List Saw38a.Cell), back d c ts acc = (genB d c ts).reverse ++ acc := by
  induction ts with
  | nil => intro d c acc; rfl
  | cons t ts ih =>
    intro d c acc
    simp only [back, genB, List.reverse_cons, List.append_assoc, List.singleton_append]
    exact ih _ _ _

theorem pathOf_eq (n T : Nat) : pathOf n T = (genB (dirI 0) (-1, 0) (digitsQ (n - 2) T).1).reverse ++ [(-1, 0), (0, 0)] := by
  unfold pathOf
  rw [back_eq]
  rfl

theorem digitsQ_succ (k T : Nat) : digitsQ (k + 1) T = (T % 3 :: (digitsQ k (T / 3)).1, (digitsQ k (T / 3)).2) := rfl

/-! ## The packed walk in the frame of `g` -/

theorem walkCells_succ (sw : Bool) (k T i p : Nat) : walkCells sw (k + 1) T i p =
    stepBackP (turnP (swapT sw (T % 3)) i) p ::
      walkCells sw k (T / 3) (turnP (swapT sw (T % 3)) i) (stepBackP (turnP (swapT sw (T % 3)) i) p) := rfl

theorem walkCells_tf {g : Nat} (hg : g < 8) (t : Saw38a.Cell) : ∀ (k T i : Nat) (c : Saw38a.Cell), i < 4 →
    Near (tf g t c) → (∀ q ∈ genB (dirI i) c (digitsQ k T).1, Near (tf g t q)) →
    walkCells (Nat.ble 4 g) k T (gdir g i) (pk (tf g t c)) = (genB (dirI i) c (digitsQ k T).1).map (fun q => pk (tf g t q)) := by
  intro k
  induction k with
  | zero => intro T i c _ _ _; rfl
  | succ k ih =>
    intro T i c hi hc hq
    rw [walkCells_succ, digitsQ_succ]
    rw [digitsQ_succ] at hq
    simp only [genB, List.map_cons, List.mem_cons, forall_eq_or_imp] at hq ⊢
    have ht3 : T % 3 < 3 := Nat.mod_lt _ (by norm_num)
    have hj := turnIdx_lt (t := T % 3) hi
    rw [turnBack_dirI hi] at hq ⊢
    rw [turn_gdir g hg i hi (T % 3) ht3]
    have hstep := tf_step hg hj t c
    obtain ⟨hn', hrest⟩ := hq
    rw [hstep] at hn'
    rw [stepBackP_pk' (gdir_lt g _) hc hn', ← hstep]
    rw [← hstep] at hn'
    rw [ih (T / 3) _ _ hj hn' hrest]

theorem tf_zero (c : Saw38a.Cell) : tf 0 (0, 0) c = c := by
  obtain ⟨a, b⟩ := c
  simp [tf, d4c, addC]

theorem gdir_zero {i : Nat} (hi : i < 4) : gdir 0 i = i := by
  unfold gdir
  show Nat.mod i 4 = i
  exact Nat.mod_eq_of_lt hi

theorem nmod (a b : Nat) : Nat.mod a b = a % b := rfl
theorem ndiv (a b : Nat) : Nat.div a b = a / b := rfl

/-! ## The own walk -/

/-- Each cell of the walk is `small` and new, with respect to the bitboard grown so far. -/
def OKList : Nat → List Nat → Prop
  | _, [] => True
  | B, q :: qs => smallP q = true ∧ bitP B q = false ∧ OKList (Nat.lor B (Nat.shiftLeft 1 q)) qs

def orBits : Nat → List Nat → Nat
  | B, [] => B
  | B, q :: qs => orBits (Nat.lor B (Nat.shiftLeft 1 q)) qs

theorem ownWalk_sound : ∀ (k T i p B x0 x1 y0 y1 : Nat) (B' : Nat) (bb : Box),
    ownWalk k T i p B x0 x1 y0 y1 = some (B', bb) →
    (digitsQ k T).2 = 0 ∧ OKList B (walkCells false k T i p) ∧ B' = orBits B (walkCells false k T i p) := by
  intro k
  induction k with
  | zero =>
    intro T i p B x0 x1 y0 y1 B' bb h
    simp only [ownWalk] at h
    cases hT : Nat.beq T 0 with
    | false => rw [hT] at h; simp at h
    | true =>
      rw [hT] at h
      simp only [Bool.cond_true, Option.some.injEq, Prod.mk.injEq] at h
      refine ⟨Nat.eq_of_beq_eq_true hT, trivial, ?_⟩
      rw [← h.1]; rfl
  | succ k ih =>
    intro T i p B x0 x1 y0 y1 B' bb h
    simp only [ownWalk, nmod, ndiv] at h
    rw [walkCells_succ, digitsQ_succ]
    have hsw : swapT false (T % 3) = T % 3 := rfl
    rw [hsw]
    cases hc : (smallP (stepBackP (turnP (T % 3) i) p) && !bitP B (stepBackP (turnP (T % 3) i) p)) with
    | false => rw [hc] at h; simp at h
    | true =>
      rw [hc] at h
      simp only [Bool.cond_true] at h
      obtain ⟨h1, h2, h3⟩ := ih _ _ _ _ _ _ _ _ _ _ h
      simp only [Bool.and_eq_true, Bool.not_eq_true'] at hc
      exact ⟨h1, ⟨hc.1, hc.2, h2⟩, h3⟩

/-- `OKList` gives no repeats and avoidance of the starting bitboard. -/
theorem okList_nodup : ∀ (qs : List Nat) (B : Nat), OKList B qs → qs.Nodup ∧ ∀ q ∈ qs, B.testBit q = false := by
  intro qs
  induction qs with
  | nil => intro B _; simp
  | cons q qs ih =>
    intro B h
    obtain ⟨-, hb, hr⟩ := h
    obtain ⟨hn, hav⟩ := ih _ hr
    rw [bitP_eq] at hb
    refine ⟨List.nodup_cons.2 ⟨fun hq => ?_, hn⟩, ?_⟩
    · have := hav q hq
      rw [testBit_lor_shiftLeft] at this
      simp at this
    · intro q' hq'
      rcases List.mem_cons.1 hq' with rfl | hq'
      · exact hb
      · have := hav q' hq'
        rw [testBit_lor_shiftLeft] at this
        simp only [Bool.or_eq_false_iff] at this
        exact this.1

theorem testBit_orBits : ∀ (qs : List Nat) (B j : Nat), (orBits B qs).testBit j = (B.testBit j || decide (j ∈ qs)) := by
  intro qs
  induction qs with
  | nil => intro B j; simp [orBits]
  | cons q qs ih =>
    intro B j
    simp only [orBits]
    rw [ih, testBit_lor_shiftLeft]
    by_cases h : q = j
    · subst h; simp
    · simp [h, eq_comm]

theorem okList_smallP : ∀ (qs : List Nat) (B : Nat), OKList B qs → ∀ q ∈ qs, smallP q = true := by
  intro qs
  induction qs with
  | nil => intro B _ q hq; simp at hq
  | cons q qs ih =>
    intro B h q' hq'
    obtain ⟨hs, -, hr⟩ := h
    rcases List.mem_cons.1 hq' with rfl | hq'
    · exact hs
    · exact ih _ hr q' hq'

/-- The own walk, step by step: every generated cell is small (so each step is exact). -/
theorem walkCells_own : ∀ (k T i : Nat) (c : Saw38a.Cell) (B : Nat), i < 4 → small c = true →
    OKList B (walkCells false k T i (pk c)) →
    walkCells false k T i (pk c) = (genB (dirI i) c (digitsQ k T).1).map pk ∧
      ∀ q ∈ genB (dirI i) c (digitsQ k T).1, small q = true := by
  intro k
  induction k with
  | zero => intro T i c B _ _ _; simp [walkCells, digitsQ, genB]
  | succ k ih =>
    intro T i c B hi hc hok
    rw [walkCells_succ] at hok ⊢
    rw [digitsQ_succ]
    simp only [genB, List.map_cons, List.mem_cons, forall_eq_or_imp]
    have hsw : swapT false (T % 3) = T % 3 := rfl
    rw [hsw] at hok ⊢
    rw [turnBack_dirI hi]
    have hj := turnIdx_lt (t := T % 3) hi
    have hturn : turnP (T % 3) i = turnIdx (T % 3) i := by
      have := turn_gdir 0 (by norm_num) i hi (T % 3) (Nat.mod_lt _ (by norm_num))
      rw [gdir_zero hi, gdir_zero hj] at this
      exact this
    rw [hturn] at hok ⊢
    rw [stepBackP_pk hj hc] at hok ⊢
    obtain ⟨hs, -, hr⟩ := hok
    have hn : Near ((c.1 - (dirI (turnIdx (T % 3) i)).1, c.2 - (dirI (turnIdx (T % 3) i)).2) : Saw38a.Cell) := by
      obtain ⟨a, b⟩ := c
      simp only [small, Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨b1, b2, b3, b4⟩ := dirI_bounds (turnIdx (T % 3) i)
      unfold Near; simp only; omega
    rw [smallP_pk hn] at hs
    obtain ⟨e, hall⟩ := ih (T / 3) _ _ _ hj hs hr
    exact ⟨by rw [e], hs, hall⟩

/-- `nodupC` is `List.Nodup`. -/
theorem nodupC_iff (l : List Saw38a.Cell) : nodupC l = true ↔ l.Nodup := by
  induction l with
  | nil => simp [nodupC]
  | cons c l ih =>
    simp only [nodupC, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true, bne_iff_ne, ne_eq, ih, List.nodup_cons]
    constructor
    · rintro ⟨h, hn⟩
      refine ⟨fun hc => ?_, hn⟩
      rcases h c hc with h1 | h2 <;> simp_all
    · rintro ⟨h, hn⟩
      refine ⟨fun d hd => ?_, hn⟩
      by_contra hcon
      push Not at hcon
      have : d = c := Prod.ext hcon.1 hcon.2
      subst this
      exact h hd

theorem testBit_gridB : ∀ (S : List (Nat × Nat)) (v j : Nat),
    (S.foldl (fun v c => setB v c.1 c.2) v).testBit j = (v.testBit j || S.any (fun c => 64 * c.2 + c.1 == j)) := by
  intro S
  induction S with
  | nil => intro v j; simp
  | cons c S ih =>
    intro v j
    simp only [List.foldl_cons, List.any_cons]
    rw [ih]
    simp only [setB, Nat.testBit_or, Nat.testBit_two_pow]
    by_cases h : 64 * c.2 + c.1 = j
    · have hb : (64 * c.2 + c.1 == j) = true := by simpa using h
      simp [h, hb]
    · have hb : (64 * c.2 + c.1 == j) = false := by simpa using h
      simp [h, hb]

theorem pk_offC (c : Saw38a.Cell) : pk c = 64 * (offC c).2 + (offC c).1 := rfl

/-- The own decode: `ownDec n T = some (Sg, bb)` validates `decode` and gives the bitboard of the path. -/
theorem ownDec_sound {n T Sg : Nat} {bb : Box} (h : ownDec n T = some (Sg, bb)) :
    ∃ S, decode n T = some S ∧ Sg = gridB (S.map offC) := by
  unfold ownDec at h
  cases hr : (Nat.blt n 2 || Nat.blt 40 n) with
  | true => rw [hr] at h; simp at h
  | false =>
    rw [hr] at h
    simp only [Bool.cond_false] at h
    have hb1 : Nat.blt n 2 = false := (Bool.or_eq_false_iff.1 hr).1
    have hb2 : Nat.blt 40 n = false := (Bool.or_eq_false_iff.1 hr).2
    have hn1 : ¬ n < 2 := fun h' => by rw [Nat.blt_eq.mpr h'] at hb1; exact Bool.noConfusion hb1
    have hn2 : ¬ 40 < n := fun h' => by rw [Nat.blt_eq.mpr h'] at hb2; exact Bool.noConfusion hb2
    have hn : 2 ≤ n ∧ n ≤ 40 := by omega
    obtain ⟨hq, hok, hB⟩ := ownWalk_sound _ _ _ _ _ _ _ _ _ _ _ h
    have h2014 : (2014 : Nat) = pk (-1, 0) := rfl
    rw [h2014] at hok hB
    have hsm : small ((-1, 0) : Saw38a.Cell) = true := by decide
    obtain ⟨hw, hgs⟩ := walkCells_own _ _ _ _ _ (by norm_num) hsm hok
    set gs := genB (dirI 0) (-1, 0) (digitsQ (n - 2) T).1 with hgsdef
    have hpath := pathOf_eq n T
    rw [← hgsdef] at hpath
    have hsmall : ∀ c ∈ pathOf n T, small c = true := by
      intro c hc
      rw [hpath] at hc
      simp only [List.mem_append, List.mem_reverse, List.mem_cons, List.not_mem_nil, or_false] at hc
      rcases hc with hc | rfl | rfl
      · exact hgs c hc
      · decide
      · decide
    obtain ⟨hnd, hav⟩ := okList_nodup _ _ hok
    rw [hw] at hnd hav
    have hgnd : gs.Nodup := hnd.of_map pk
    have hdisj : ∀ q ∈ gs, q ≠ (-1, 0) ∧ q ≠ (0, 0) := by
      intro q hq
      have h0 := hav (pk q) (List.mem_map_of_mem hq)
      rw [testBit_lor_shiftLeft, testBit_shiftLeft_one] at h0
      simp only [Bool.or_eq_false_iff, decide_eq_false_iff_not] at h0
      refine ⟨fun e => h0.1 (by rw [e]), fun e => h0.2 (by rw [e]; rfl)⟩
    have hnodup : (pathOf n T).Nodup := by
      rw [hpath]
      refine List.Nodup.append (List.nodup_reverse.2 hgnd) (by decide) ?_
      intro a ha hb
      rw [List.mem_reverse] at ha
      obtain ⟨h1, h2⟩ := hdisj a ha
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hb
      rcases hb with hb | hb
      · exact h1 hb
      · exact h2 hb
    refine ⟨pathOf n T, ?_, ?_⟩
    · unfold decode
      have c1 : (decide (n < 2) || decide (40 < n)) = false := by
        simp only [Bool.or_eq_false_iff, decide_eq_false_iff_not]; omega
      have c2 : ((digitsQ (n - 2) T).2 != 0) = false := by rw [hq]; rfl
      have c3 : ((pathOf n T).all small && nodupC (pathOf n T)) = true := by
        rw [Bool.and_eq_true, List.all_eq_true, nodupC_iff]
        exact ⟨hsmall, hnodup⟩
      simp only [c1, c2, c3, Bool.false_eq_true, ↓reduceIte]
    · rw [hB, hw]
      apply Nat.eq_of_testBit_eq
      intro j
      rw [testBit_orBits]
      unfold gridB
      rw [testBit_gridB, hpath]
      rw [testBit_lor_shiftLeft, testBit_shiftLeft_one]
      simp only [Nat.zero_testBit, Bool.false_or, List.map_append, List.map_reverse, List.any_append,
        List.any_reverse, List.map_cons, List.map_nil, List.any_cons, List.any_nil, Bool.or_false]
      rw [Bool.eq_iff_iff]
      simp only [Bool.or_eq_true, decide_eq_true_eq, List.mem_map, List.any_map, List.any_eq_true,
        Function.comp_def, beq_iff_eq, ← pk_offC]
      have e1 : pk ((-1 : Int), (0 : Int)) = 2014 := rfl
      have e2 : pk ((0 : Int), (0 : Int)) = 2015 := rfl
      rw [e1, e2]
      constructor
      · rintro ((h | h) | ⟨q, hq, rfl⟩)
        · right; left; exact h
        · right; right; exact h
        · left; exact ⟨q, hq, rfl⟩
      · rintro (⟨q, hq, rfl⟩ | h | h)
        · right; exact ⟨q, hq, rfl⟩
        · left; left; exact h
        · left; right; exact h

end K30BP

end
